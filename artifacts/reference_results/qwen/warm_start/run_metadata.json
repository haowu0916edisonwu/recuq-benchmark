{
  "base_predictions": "artifacts/base_predictions/qwen_warm_start_fixed_rankings.jsonl.gz",
  "base_records": 4000,
  "base_records_after_tail_target_filter": 4000,
  "bootstrap": {
    "metrics": [
      "error_auroc",
      "error_auprc",
      "risk_at_80",
      "aurc",
      "eaurc"
    ],
    "paired_across_methods": true,
    "resamples": 1000,
    "scenario": "s0_warmstart",
    "seed": 42,
    "strata": [
      "dataset"
    ],
    "unit": "record"
  },
  "joined_records": 32000,
  "joined_records_after_tail_target_filter": 32000,
  "label_key": "is_error_at_10",
  "metric_definitions": {
    "aurc": "mean selective risk over every retained-prefix coverage from 1/n through 1",
    "eaurc": "aurc minus oracle_aurc; lower is better",
    "error_auprc": "average_precision_score(is_error_at_10, uncertainty_score)",
    "oracle_aurc": "minimum AURC obtainable for the observed number of errors",
    "risk_at_c": "error rate after retaining the lowest-uncertainty floor(c*n) records"
  },
  "output_dir": "artifacts/reference_results/qwen/warm_start",
  "tail_target_included_buckets": [
    "tail"
  ],
  "uq_predictions": [
    "artifacts/uq_outputs/qwen/labelprob_max.jsonl.gz",
    "artifacts/uq_outputs/qwen/labelprob_top10mass.jsonl.gz",
    "artifacts/uq_outputs/qwen/labelprob_entropy.jsonl.gz",
    "artifacts/uq_outputs/qwen/labelprob_margin.jsonl.gz",
    "artifacts/uq_outputs/qwen/temperature_scaled_labelprob.jsonl.gz",
    "artifacts/uq_outputs/qwen/decomposed_llm_uq.jsonl.gz",
    "artifacts/uq_outputs/qwen/perturbation_rank_instability.jsonl.gz",
    "artifacts/uq_outputs/qwen/self_consistency.jsonl.gz"
  ]
}
